---
import Pre from "@/components/Pre.astro";

interface Props {
  pageTitle: string;
  socialTitle: string;
  description: string;
  author: string;
  canonicalUrl: string;
  /** Article pages get the article og:type, the compact banner and no header. */
  article?: boolean;
  publishedAt?: string;
  jsonLd: Record<string, unknown>;
}

const {
  pageTitle,
  socialTitle,
  description,
  author,
  canonicalUrl,
  article = false,
  publishedAt,
  jsonLd,
} = Astro.props;

// Matches Ruby's JSON.generate(...).gsub("</", "<\\/") so the payload can never
// close the surrounding <script>.
const jsonLdText = JSON.stringify(jsonLd).replaceAll("</", "<\\/");

const stylesheets = ["reset", "root", "fonts", "header", "pre", "news"];
const fontPreloads = ["/assets/fonts/JetBrainsMono-Regular.woff2"];
---

<!doctype html>
<html lang="en">
  <head>
    <title>{pageTitle}</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    {fontPreloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/assets/images/favicon.png" />

    <meta property="og:site_name" content="Omarchy News" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://omarchy.org/assets/images/social.png"
    />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Omarchy logo" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta property="article:published_time" content={publishedAt} />
          <meta property="article:author" content={author} />
        </>
      )
    }

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://omarchy.org/assets/images/social.png"
    />
    <meta name="twitter:image:alt" content="Omarchy logo" />

    <script type="application/ld+json" is:inline set:html={jsonLdText} />

    {
      stylesheets.map((name) => (
        <link rel="stylesheet" href={`/assets/css/${name}.css`} />
      ))
    }

    <script
      defer
      data-domain="omarchy.org"
      src="https://plausible.io/js/script.js"
      is:inline></script>
  </head>

  <body class="news-body">
    <Pre class={article ? "pre pre--news" : "pre"} />

    {
      !article && (
        <header class="header">
          <h1>Announcements, releases, and other news</h1>
        </header>
      )
    }

    <main class="news-page">
      <slot />
    </main>
  </body>
</html>
