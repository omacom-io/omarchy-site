---
import Pre from "@/components/Pre.astro";

interface Props {
  title: string;
  description: string;
  /** The page's path, which the og:url is built from. */
  path: string;
}

const { title, description, path } = Astro.props;

const stylesheets = [
  "reset", "root", "fonts", "elements", "footer",
  "header", "main", "pre", "manual", "search",
];
const fontPreloads = [
  "/assets/fonts/JetBrainsMono-Light.woff2",
  "/assets/fonts/JetBrainsMono-Regular.woff2",
  "/assets/fonts/JetBrainsMono-Bold.woff2",
];
---

<!doctype html>
<html lang="en">
  <head>
    <title>{title} — The Omarchy Manual</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    {fontPreloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={description} />

    <meta property="og:site_name" content="Omarchy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://omarchy.org/assets/images/opengraph.png" />
    <meta property="og:url" content={`https://omarchy.org${path}`} />
    <meta property="og:type" content="article" />

    <link rel="icon" href="/assets/images/favicon.png" />

    {
      stylesheets.map((name) => (
        <link rel="stylesheet" type="text/css" href={`/assets/css/${name}.css`} />
      ))
    }

    <script defer data-domain="omarchy.org" src="https://plausible.io/js/script.js" is:inline
    ></script>
  </head>

  <body>
    <Pre />

    <header class="header">
      <h1>The Manual</h1>
    </header>

    <main class="main">
      <slot />
    </main>
  </body>
</html>
