---
import Layout from "@/layouts/Layout.astro";
import Pre from "@/components/Pre.astro";
---

<Layout
  title="Omarchy — The Teams"
  description="The teams guiding Omarchy."
  canonical="https://omarchy.org/teams"
  ogTitle="The Omarchy Teams"
  ogImage="https://omarchy.org/assets/images/teams-social.png"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="Omarchy logo"
  ogUrl="https://omarchy.org/teams"
  fontPreloads={[]}
  styles={["header", "main", "pre", "teams"]}
>
  <Pre />

  <header class="header">
    <h1>The teams guiding Omarchy</h1>
  </header>

  <main class="main">
    <div class="teams">
      <section class="team" id="core">
        <header class="team__header">
          <h2 class="team__name">Omarchy Core</h2>
          <p class="team__description">Setting the direction</p>
        </header>

        <div class="team__members">
          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/dhh.webp"
              width="240"
              height="240"
              alt="DHH"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name"><a href="https://dhh.dk">DHH</a></h3>
            <p class="member__meta">USA/Denmark</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/ryan-hughes.webp"
              width="240"
              height="240"
              alt="Ryan Hughes"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/ryanrhughes">Ryan Hughes</a>
            </h3>
            <p class="member__meta">USA</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/tobi-lutke.webp"
              width="240"
              height="240"
              alt="Tobi Lütke"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/tobi">Tobi Lütke</a>
            </h3>
            <p class="member__meta">Canada</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/bjarne-overli.webp"
              width="240"
              height="240"
              alt="Bjarne Øverli"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/iamdothash">Bjarne Øverli</a>
            </h3>
            <p class="member__meta">Norway</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/hancore.webp"
              width="240"
              height="240"
              alt="HANCORE"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://github.com/HANCORE-linux">HANCORE</a>
            </h3>
            <p class="member__meta">Germany</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/spencer-bull.webp"
              width="240"
              height="240"
              alt="Spencer Bull"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/SpencerGBull">Spencer Bull</a>
            </h3>
            <p class="member__meta">USA</p>
          </article>
        </div>
      </section>

      <section class="team" id="security">
        <header class="team__header">
          <h2 class="team__name">Omarchy Security</h2>
          <p class="team__description">Keeping your system safe</p>
        </header>

        <div class="team__members">
          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/adrian-rangel.webp"
              width="240"
              height="240"
              alt="Adrian Rangel"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/acrogenesis">Adrian Rangel</a>
            </h3>
            <p class="member__meta">Mexico</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/mehmet-ince.webp"
              width="240"
              height="240"
              alt="Mehmet İnce"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/mdisec">Mehmet İnce</a>
            </h3>
            <p class="member__meta">UK</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/erik-melton.webp"
              width="240"
              height="240"
              alt="Erik Melton"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/meltonaerik">Erik Melton</a>
            </h3>
            <p class="member__meta">Norway</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/sayem-chowdhury.webp"
              width="240"
              height="240"
              alt="Sayem Chowdhury"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/Sayem314">Sayem Chowdhury</a>
            </h3>
            <p class="member__meta">Bangladesh</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/ryan-hughes.webp"
              width="240"
              height="240"
              alt="Ryan Hughes"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name">
              <a href="https://x.com/ryanrhughes">Ryan Hughes</a>
            </h3>
            <p class="member__meta">USA</p>
          </article>

          <article class="member">
            <img
              class="member__avatar"
              src="/assets/images/team/dhh.webp"
              width="240"
              height="240"
              alt="DHH"
              loading="lazy"
              decoding="async"
            />
            <h3 class="member__name"><a href="https://dhh.dk">DHH</a></h3>
            <p class="member__meta">USA/Denmark</p>
          </article>
        </div>

        <p class="team__note">
          <a href="/security/">Report a security issue</a>
        </p>
      </section>

      <section class="team" id="rangers">
        <header class="team__header">
          <h2 class="team__name">Omarchy Rangers</h2>
          <p class="team__description">Helping others find their way</p>
        </header>

        <p class="team__note">Details coming soon</p>
      </section>
    </div>
  </main>
</Layout>
