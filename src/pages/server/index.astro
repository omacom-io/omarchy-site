---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Omarchy Server 4.0"
  description="Coming 2026"
  canonical="https://omarchy.org/server"
  ogTitle="Omarchy Server 4.0"
  ogImage="https://omarchy.org/assets/images/social/server.jpg"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="Omarchy Server 4.0"
  ogUrl="https://omarchy.org/server"
  fontPreloads={[]}
  styles={["main", "server"]}
  bodyClass="server-body"
>
  <main class="main main--error">
    <div class="server">
      <a href="/" aria-label="Omarchy">
        <img
          src="/assets/images/omarchy-server.webp"
          width="1536"
          height="1024"
          alt="Omarchy Server 4.0"
        />
      </a>
      <p class="server__coming">Coming 2026</p>
    </div>
  </main>
</Layout>
