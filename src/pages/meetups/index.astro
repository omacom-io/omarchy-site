---
import Layout from "@/layouts/Layout.astro";
import Pre from "@/components/Pre.astro";
import LumaIcon from "@/components/icons/LumaIcon.astro";
---

<Layout
  title="Meetups — Omarchy"
  description="Omarchy meetups around the world, and the short list of guidelines for running one."
  canonical="https://omarchy.org/meetups"
  ogTitle="Omarchy meetups"
  ogImage="https://omarchy.org/assets/images/social/meetups.png"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="Omarchy logo"
  ogUrl="https://omarchy.org/meetups"
  fontPreloads={[]}
  styles={["button", "header", "main", "pre", "meetups"]}
>
  <Pre />

  <header class="header">
    <h1>Meetups around the world</h1>
  </header>

  <main class="main">
    <div class="meetups">
      <div class="meetups__calendar">
        <iframe
          class="meetups__embed"
          src="https://luma.com/embed/calendar/cal-SDGGMsEps9ExsrT/events?lt=dark"
          width="600"
          height="450"
          title="Upcoming Omarchy meetups on Luma"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>

        <a
          class="button"
          href="https://luma.com/omarchy"
          aria-label="The Omarchy calendar on Luma"
        >
          <LumaIcon class="button__icon" />
          <span>Open in Luma</span>
        </a>
      </div>

      <section class="rules">
        <header class="rules__header">
          <h2 class="rules__title">Run Your Own Omarchy Meetup</h2>
          <p>Help make computers fun again for everyone</p>
        </header>

        <ol>
          <li class="rule">
            <p class="rule__name">About Omarchy</p><p>
              The meetup should primarily be about Omarchy, Linux, open source,
              programming, customization, or adjacent hacker culture.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">Open to everyone</p><p>
              No invitation-only &ldquo;official Omarchy&rdquo; events. Capacity
              limits are obviously fine.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">Community-run</p><p>
              Organizers speak for themselves, not for Omarchy or the Omacom
              Foundation. &ldquo;Omarchy Meetup&rdquo; means community event,
              not official endorsement.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">No territorial ownership</p><p>
              Nobody owns a city. Anyone may organize an Omarchy meetup
              anywhere.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">No profiteering</p><p>
              Free is preferred. Charging to cover venue, food, or actual event
              costs is fine; don&rsquo;t turn the Omarchy name into an events
              business.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">Sponsors are fine</p><p>
              Local companies can provide space, pizza, drinks, and the rest,
              but sponsorship must be disclosed and the event can&rsquo;t become
              a sales pitch.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">
              Behave like civilized adults (with child-like wonder)
            </p><p>
              Don't be a jackass. The organizer has final say over removal from
              their event.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">Use the name and logo responsibly</p><p>
              &ldquo;Omarchy Copenhagen&rdquo; is fine. Don&rsquo;t imply that
              you&rsquo;re Omarchy itself, the Omacom Foundation, or an
              authorized representative.
            </p>
          </li>
          <li class="rule">
            <p class="rule__name">
              <a href="https://luma.com/omarchy">Submit it</a>
            </p><p>
              Put the event on Luma and submit it to the global Omarchy calendar
              so everyone can find it.
            </p>
          </li>
        </ol>

        <p class="rules__note">
          We need a movement to make The Prophecy come true!
        </p>
      </section>
    </div>
  </main>
</Layout>
