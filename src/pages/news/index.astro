---
import NewsMeta from "@/components/NewsMeta.astro";
import NewsLayout from "@/layouts/NewsLayout.astro";
import { description, formatDate, newsPosts, postPath } from "@/lib/news";

const posts = await newsPosts();
const canonicalUrl = "https://omarchy.org/news";
const indexDescription =
  "Notes on the people, ideas, and releases shaping Omarchy.";
---

<NewsLayout
  pageTitle="Omarchy News"
  socialTitle="Omarchy News"
  description={indexDescription}
  author="Omarchy"
  canonicalUrl={canonicalUrl}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Omarchy News",
    description: indexDescription,
    url: canonicalUrl,
    publisher: { "@type": "Organization", name: "Omarchy" },
  }}
>
  <section class="news-list" aria-label="News posts">
    {
      posts.map((post) => (
        <article class="news-card">
          <header>
            <NewsMeta post={post} />
            <h2 class="news-card__title">{post.data.title}</h2>
          </header>

          <div class="news-card__excerpt">{description(post)}</div>

          <a
            class="news-card__link"
            href={postPath(post)}
            aria-label={`Post: ${post.data.title}, on ${formatDate(post.data.date)}`}
          >
            Read more
          </a>

          <div class="news-card__more" aria-hidden="true">
            <span class="news-card__button">Read more</span>
          </div>
        </article>
      ))
    }
  </section>
</NewsLayout>
