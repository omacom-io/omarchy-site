---
import NewsMeta from "@/components/NewsMeta.astro";
import NewsLayout from "@/layouts/NewsLayout.astro";
import { date, description, formatDate, newsPosts, postPath, title } from "@/lib/news";
import { currentPageUrl, type StructuredData } from "@/lib/seo";

const posts = await newsPosts();
const canonicalUrl = currentPageUrl(Astro);
const indexDescription =
  "Notes on the people, ideas, and releases shaping Omarchy.";
---

<NewsLayout
  seo={{
    title: "Omarchy News",
    description: indexDescription,
    canonicalUrl,
    ogSiteName: "Omarchy News",
    socialTitle: "Omarchy News",
    socialDescription: indexDescription,
    image: {
      url: "https://omarchy.org/assets/images/social.png",
      width: "600",
      height: "600",
      alt: "Omarchy logo",
    },
    ogUrl: canonicalUrl,
    ogType: "website",
    twitter: { card: "summary" },
    author: "Omarchy",
    structuredData: [{
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Omarchy News",
    description: indexDescription,
    url: canonicalUrl,
    publisher: { "@type": "Organization", name: "Omarchy" },
    } satisfies StructuredData],
  }}
>
  <section class="news-list" aria-label="News posts">
    {
      posts.map((post) => (
        <article class="news-card">
          <header>
            <NewsMeta post={post} />
            <h2 class="news-card__title" set:text={title(post)} />
          </header>

          <div class="news-card__excerpt" set:text={description(post)} />

          <a
            class="news-card__link"
            href={postPath(post)}
            aria-label={`Post: ${title(post)}, on ${formatDate(date(post))}`}
            set:text="Read more"
          />

          <div class="news-card__more" aria-hidden="true">
            <span class="news-card__button">Read more</span>
          </div>
        </article>
      ))
    }
  </section>
</NewsLayout>
