---
import type { GetStaticPaths } from "astro";
import NewsMeta from "@/components/NewsMeta.astro";
import NewsLayout from "@/layouts/NewsLayout.astro";
import {
  date,
  description,
  html,
  isoDate,
  newsPosts,
  postPath,
  title,
  type Post,
} from "@/lib/news";

export const getStaticPaths = (async () => {
  const posts = await newsPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { author, author_url } = post.data;

const canonicalUrl = `https://omarchy.org${postPath(post)}`;
const heading = title(post);
const publishedAt = isoDate(date(post));
const summary = description(post);
---

<NewsLayout
  pageTitle={`${heading} — Omarchy News`}
  socialTitle={heading}
  description={summary}
  author={author}
  canonicalUrl={canonicalUrl}
  article
  publishedAt={publishedAt}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: heading,
    description: summary,
    datePublished: publishedAt,
    author: {
      "@type": author_url ? "Person" : "Organization",
      name: author,
      ...(author_url ? { url: author_url } : {}),
    },
    publisher: {
      "@type": "Organization",
      name: "Omarchy",
      logo: {
        "@type": "ImageObject",
        url: "https://omarchy.org/assets/images/favicon.png",
      },
    },
    image: "https://omarchy.org/assets/images/favicon.png",
    mainEntityOfPage: canonicalUrl,
  }}
>
  <article class="news-post">
    <header class="news-post__header">
      <NewsMeta post={post} prefix="By " />
      <h1 class="news-post__title" set:text={heading} />
    </header>

    <div class="news-prose">
      <Fragment set:html={html(post)} />
    </div>
  </article>
</NewsLayout>
