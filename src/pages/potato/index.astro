---
import Layout from "@/layouts/Layout.astro";
import Pre from "@/components/Pre.astro";
---

<Layout
  title="Runs great on ancient hardware — Omarchy"
  description="Runs great on ancient hardware."
  canonical="https://omarchy.org/potato"
  ogTitle="Runs great on ancient hardware"
  ogImage="https://omarchy.org/assets/images/potato-social.png"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="Omarchy logo"
  ogUrl="https://omarchy.org/potato"
  fontPreloads={[]}
  styles={["header", "main", "pre", "video"]}
>
  <Pre />

  <header class="header">
    <h1>Runs great on ancient hardware</h1>
  </header>

  <main class="main">
    <div class="video">
      <iframe
        title="Omarchy running on 2011 X220 2GB RAM (with room to spare)"
        src="https://www.youtube-nocookie.com/embed/jgSjG0IYw4o"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </main>
</Layout>
