      <section class="news-list" aria-label="News posts">
<% posts.each do |post| -%>
        <article class="news-card">
          <header>
            <p class="news-meta">
              <span class="news-byline"><%= post.author_url ? %(<a href="#{h post.author_url}" rel="author">#{h post.author}</a>) : h(post.author) %></span> on <time class="news-date" datetime="<%= post.date.iso8601 %>"><%= h format_date(post.date) %></time>
            </p>
            <h2 class="news-card__title"><%= h post.title %></h2>
          </header>

          <div class="news-card__excerpt"><%= h post.description %></div>

          <a class="news-card__link" href="<%= h post.path %>" aria-label="Post: <%= h post.title %>, on <%= h format_date(post.date) %>">Read more</a>

          <div class="news-card__more" aria-hidden="true">
            <span class="news-card__button">Read more</span>
          </div>
        </article>
<% end -%>
      </section>
