  <div class="manual manual--chapter">
    <div class="manual__sidebar">
<%= render "search", {} -%>
      <nav class="manual__toc" aria-label="Chapters">
        <ol>
<%- chapters.each do |other| -%>
          <li><a href="<%= other.path %>"<%= %( aria-current="page") if other == chapter %>><%= h other.title %></a></li>
<%- end -%>
        </ol>
      </nav>
    </div>

    <article class="manual__content">
      <h1><%= h chapter.title %></h1>
<%= content %>
      <nav class="manual__pagination">
<%- if previous_chapter -%>
        <a class="manual__pagination-previous" href="<%= previous_chapter.path %>" rel="prev">← <%= h previous_chapter.title %></a>
<%- else -%>
        <span></span>
<%- end -%>
        <a class="manual__pagination-contents" href="/manual/toc/">Table of Contents</a>
<%- if next_chapter -%>
        <a class="manual__pagination-next" href="<%= next_chapter.path %>" rel="next"><%= h next_chapter.title %> →</a>
<%- else -%>
        <span></span>
<%- end -%>
      </nav>
    </article>
  </div>
