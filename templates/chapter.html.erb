  <div class="manual">
    <nav class="manual__chapters">
      <div class="manual__container">
<%= render "_search" -%>

        <ol>
<%= render "_chapters", chapters: chapters, current_path: chapter.path -%>
        </ol>
      </div>
    </nav>

    <div class="manual__content">
      <article class="manual__article">
        <h1><%= h chapter.title %></h1>
<%= content %>
      </article>

      <nav class="manual__pagination">
        <a class="manual__pagination-button manual__pagination-button--previous" href="<%= previous_chapter.path %>" rel="prev">
          <dl>
            <dt><- Previous</dt>
            <dd><%= h previous_chapter.title %></dd>
          </dl>
        </a>

        <a class="manual__pagination-button manual__pagination-button--next" href="<%= next_chapter.path %>" rel="next">
          <dl>
            <dt>Next -></dt>
            <dd><%= h next_chapter.title %></dd>
          </dl>
        </a>
      </nav>
    </div>
  </div>
