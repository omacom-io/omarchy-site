  <div class="manual manual--index">
<%= render "search", {} -%>
    <nav class="manual__index" style="--chapter-rows: <%= (chapters.size + 1) / 2 %>" aria-label="Chapters">
      <ol>
<%- chapters.each do |chapter| -%>
        <li><a href="<%= chapter.path %>"><%= h chapter.title %></a></li>
<%- end -%>
      </ol>
    </nav>
  </div>
