  <div class="manual">
    <nav class="manual__chapters">
      <div class="manual__container manual__container--chapters">
<%= render "_search" -%>

        <ol>
<%= render "_chapters", chapters: chapters, current_path: nil -%>
        </ol>
      </div>
    </nav>

    <div class="manual__container manual__container--content">
<%= render "_location", title: "Search" -%>

      <header class="manual__header">
        <h1 class="search-query">Search results for “<mark></mark>”</h1>
      </header>

      <div class="search-results">
        <div class="search-results__entries"></div>
      </div>
    </div>
  </div>

  <script>window.store = <%= store_json %>;</script>
